;; Lints a defui or buzz/defn body as ClojureScript and its server forms as Clojure.
{:hooks {:analyze-call {buzz.core/defui hooks.buzz.core/component
                        buzz.core/defn hooks.buzz.core/component
                        buzz.core/defpart hooks.buzz.core/component
                        buzz.core/server hooks.buzz.core/server
                        buzz.core/server! hooks.buzz.core/server
                        buzz.core/client hooks.buzz.core/client
                        buzz.core/host hooks.buzz.core/host}}}
