;; Babashka supplies fs, cheshire and http-kit itself, but a JVM consumer needs
;; them on the classpath, so they are listed here.
{:paths ["src" "resources"]
 :deps {io.github.borkdude/reagami {:git/sha "07b058931c9ec1caf70327e1532293c4c088c330"}
        io.github.squint-cljs/squint {:git/tag "v0.14.208"
                                      :git/sha "e83befd03153b842d45cd25a77fefb915f120eb7"}
        babashka/fs {:mvn/version "0.5.26"}
        cheshire/cheshire {:mvn/version "6.1.0"}
        ;; 2.7.0 to 2.8.1 do not notice a client that went away, so a browser
        ;; that closed a stream is watched forever. Babashka carries its own
        ;; http-kit, which is why this only shows on the JVM. See http-kit #578.
        http-kit/http-kit {:mvn/version "2.9.0-beta4"}}
 ;; The same tests run on both runtimes. A macro reaching a private var is legal
 ;; under SCI and fatal on the JVM, so only running both finds it.
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               ;; a second server, so the stream adapter is
                               ;; tested against something that is not http-kit
                               dev.weavejester/capra {:mvn/version "0.1.3"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
