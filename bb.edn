{:paths ["src" "resources"]
 :deps {;; Capra is used only by tests. bb.edn has no test alias.
        dev.weavejester/capra {:mvn/version "0.1.3"}
        io.github.borkdude/reagami {:git/sha "d7d526d8a4472b94ba01ee82fbfc44bb6a12ab8d"}
        io.github.squint-cljs/squint {:git/tag "v0.14.210"
                                      :git/sha "bbea201424d670119306da8d09cdd892b03c32e1"}}
 :tasks {
         test  {:doc "Run the tests"
                :extra-paths ["test"]
                :requires ([clojure.test :as t] [buzz.core-test] [buzz.handler-test])
                ;; Capra leaves non-daemon threads after a closed test stream.
                :task (let [{:keys [fail error]} (t/run-tests 'buzz.core-test 'buzz.handler-test)]
                        (System/exit (if (pos? (+ fail error)) 1 0)))}
         serve {:doc "Start the demo on http://localhost:1341"
                :requires ([buzz.app :as app])
                :task (app/-main)}
         dev   {:doc "Start the demo plus an nrepl on 1667. Re-evaluate a defui and the page updates."
                :requires ([buzz.app :as app])
                :task (app/-main "--nrepl")}
         bench {:doc "A table of N rows on http://localhost:1342, for measuring"
                :requires ([buzz.bench :as bench])
                :task (bench/-main "--nrepl")}
         bench-topics {:doc "Compare rendering with whole-atom and per-user observations"
                       :extra-paths ["test"]
                       :requires ([buzz.topics-bench :as tb])
                       :task (tb/-main)}
         split {:doc "Print what the splitter makes of the demo component"
                :requires ([buzz.app :as app])
                :task (let [inst (app/todo-app)]
                        (println "id      " (:id inst))
                        (println "js      " (:js inst))
                        (println "slots   " (if (:request inst)
                                              ((:slots inst) {})
                                              ((:slots inst))))
                        (println "handlers" (sort (keys (:handlers inst)))))}}}
